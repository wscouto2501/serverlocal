
#!/usr/bin/env bash
set -Eeuo pipefail

# ==========================================================
# VOCERO CRM - Instalador automático para Ubuntu
# Repositório: https://github.com/kevinrivm/vocero-crm
# ==========================================================
clear

REPO_URL="https://github.com/wscouto2501/vocero-crm.git"
INSTALL_DIR="/opt/vocero"

log()  { echo -e "\n\033[1;32m[INFO]\033[0m $*"; }
warn() { echo -e "\n\033[1;33m[AVISO]\033[0m $*"; }
die()  { echo -e "\n\033[1;31m[ERRO]\033[0m $*" >&2; exit 1; }

trap 'die "Falha na linha $LINENO. Confira a mensagem acima."' ERR

# 1. Verificar sistema operacional
if [[ "${EUID}" -ne 0 ]]; then
    die "Execute como root: sudo bash instalar-vocero.sh"
fi

if [[ ! -f /etc/os-release ]]; then
    die "Não foi possível identificar o sistema operacional."
fi

. /etc/os-release

if [[ "${ID:-}" != "ubuntu" ]]; then
    warn "Este script foi preparado para Ubuntu. Sistema detectado: ${PRETTY_NAME:-desconhecido}"
    read -r -p "Deseja continuar mesmo assim? (s/N): " CONFIRM
    [[ "${CONFIRM}" =~ ^[sS]$ ]] || exit 1
fi

# 2. Solicitar domínio
echo
read -r -p "Digite o domínio do CRM (ex.: crm.seudominio.com): " DOMAIN
DOMAIN="${DOMAIN,,}"

if [[ ! "$DOMAIN" =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]]; then
    die "Domínio inválido. Informe um domínio completo, sem https:// ou caminhos."
fi

# 3. Atualizar sistema e instalar ferramentas básicas
log "Atualizando pacotes do sistema..."
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y \
    ca-certificates \
    curl \
    git \
    gnupg \
    openssl \
    xz-utils \
    tar \
    bash \
    coreutils \
    libatomic1

# 4. Instalar Docker, caso não exista
if ! command -v docker >/dev/null 2>&1; then
    log "Instalando Docker Engine..."
    curl -fsSL https://get.docker.com -o /tmp/install-docker.sh
    sh /tmp/install-docker.sh
    rm -f /tmp/install-docker.sh
else
    log "Docker já está instalado."
fi

# 5. Verificar Docker Compose
if ! docker compose version >/dev/null 2>&1; then
    die "Docker Compose v2 não está disponível. Verifique a instalação do Docker."
fi

systemctl enable --now docker

log "Versões instaladas:"
docker --version
docker compose version

# 6. Instalar Node.js 22, se necessário
NODE_OK=0

if command -v node >/dev/null 2>&1; then
    NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
    if [[ "$NODE_MAJOR" == "22" ]]; then
        NODE_OK=1
    fi
fi

if [[ "$NODE_OK" -ne 1 ]]; then
    log "Instalando Node.js 22..."
    curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource.sh
    bash /tmp/nodesource.sh
    rm -f /tmp/nodesource.sh
    apt-get install -y nodejs
fi

# 7. Instalar pnpm
log "Preparando pnpm..."

if ! command -v pnpm >/dev/null 2>&1; then
    npm install --global pnpm
fi

node --version
npm --version
pnpm --version

# 8. Clonar o projeto
if [[ -d "$INSTALL_DIR/.git" ]]; then
    log "Repositório existente encontrado em $INSTALL_DIR."
    warn "O script não fará git pull nem substituirá arquivos existentes."
else
    if [[ -e "$INSTALL_DIR" ]]; then
        die "$INSTALL_DIR já existe e não é um repositório Git. Faça backup ou escolha outro diretório."
    fi

    log "Clonando Vocero CRM..."
    mkdir -p "$(dirname "$INSTALL_DIR")"
    git clone "$REPO_URL" "$INSTALL_DIR"
fi

cd "$INSTALL_DIR"

# 9. Instalar dependências Node.js
log "Instalando dependências do projeto..."
pnpm install --frozen-lockfile

# 10. Criar configuração e segredos
if [[ ! -f .env ]]; then
    log "Gerando .env e segredos para $DOMAIN..."
    pnpm init-env --domain "$DOMAIN"
else
    warn "O arquivo .env já existe. Não será sobrescrito."
    warn "Confira se DOMAIN e APP_BASE_URL correspondem ao domínio desejado."
fi



# 10.1. Configurar Caddy para funcionar atrás do Cloudflare Tunnel
log "Configurando Caddy para uso com Cloudflare Tunnel..."

if [[ -f Caddyfile ]]; then
    cp Caddyfile Caddyfile.backup

    cat > Caddyfile <<'EOF'
http://{$DOMAIN} {
    reverse_proxy app:3000 {
        flush_interval -1
    }
    encode gzip
}
EOF
else
    die "Caddyfile não encontrado em $INSTALL_DIR."
fi




# 11. Verificar configuração
log "Validando o ambiente..."
pnpm doctor

# 12. Inicializar serviços
log "Iniciando o Vocero CRM com Docker Compose..."
docker compose up -d

# 13. Mostrar estado dos containers
log "Estado dos serviços:"
docker compose ps

echo
log "Instalação concluída."
echo "Domínio configurado: $DOMAIN"
echo "Diretório: $INSTALL_DIR"
echo "URL: https://$DOMAIN"
echo "Healthcheck: https://$DOMAIN/api/health"
echo
echo "Para acompanhar os logs:"
echo "  cd $INSTALL_DIR && docker compose logs -f"
echo
echo "Para reiniciar:"
echo "  cd $INSTALL_DIR && docker compose restart"
echo
echo "Para verificar os serviços:"
echo "  cd $INSTALL_DIR && docker compose ps"
