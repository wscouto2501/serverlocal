const hre = require("hardhat");
const fs = require("fs");
const path = require("path");

async function main() {

  const cfg = JSON.parse(
    fs.readFileSync(
      path.join(__dirname, "../.stablecoin-config.json"),
      "utf8"
    )
  );

  if (!process.env.PRIVATE_KEY) {
    throw new Error("PRIVATE_KEY não configurada.");
  }

  const network = await hre.ethers.provider.getNetwork();

  if (network.chainId !== 137n) {
    throw new Error("Rede incorreta. Esperado Polygon Mainnet.");
  }

  const [deployer] = await hre.ethers.getSigners();

  const balance = await hre.ethers.provider.getBalance(
    deployer.address
  );

  if (balance === 0n) {
    throw new Error("Carteira sem POL para pagar gas.");
  }

  const collateral = cfg.collateral;

  if (!hre.ethers.isAddress(collateral)) {
    throw new Error("Endereço de colateral inválido.");
  }

  const collateralCode =
    await hre.ethers.provider.getCode(collateral);

  if (collateralCode === "0x") {
    throw new Error("Contrato de colateral inexistente.");
  }

  const collateralContract = new hre.ethers.Contract(
    collateral,
    [
      "function symbol() view returns (string)",
      "function decimals() view returns (uint8)"
    ],
    hre.ethers.provider
  );

  const [collateralSymbol, collateralDecimals] =
    await Promise.all([
      collateralContract.symbol(),
      collateralContract.decimals()
    ]);

  if (collateralDecimals !== 6n) {
    throw new Error("Colateral precisa ter 6 decimais.");
  }

  console.log("======================================");
  console.log("IMPLANTAÇÃO DA STABLECOIN");
  console.log("======================================");
  console.log("Nome:", cfg.name);
  console.log("Símbolo:", cfg.symbol);
  console.log("Colateral:", collateral);
  console.log("Símbolo do colateral:", collateralSymbol);
  console.log("Carteira:", deployer.address);
  console.log("Saldo POL:", hre.ethers.formatEther(balance));
  console.log("Supply inicial: ZERO");

  const Factory = await hre.ethers.getContractFactory(
    "Stablecoin"
  );

  const token = await Factory.deploy(
    cfg.name,
    cfg.symbol,
    collateral
  );

  await token.waitForDeployment();

  const address = await token.getAddress();

  const tx = token.deploymentTransaction();

  const result = {
    network: "Polygon Mainnet",
    chainId: 137,
    name: cfg.name,
    symbol: cfg.symbol,
    decimals: 6,
    collateral,
    collateralSymbol,
    deployer: deployer.address,
    contractAddress: address,
    transactionHash: tx.hash,
    explorer: `https://polygonscan.com/address/${address}`,
    deployedAt: new Date().toISOString()
  };

  const output = path.join(
    __dirname,
    "../deployments/polygon.json"
  );

  fs.writeFileSync(
    output,
    JSON.stringify(result, null, 2),
    { mode: 0o600 }
  );

  console.log("======================================");
  console.log("CONTRATO IMPLANTADO");
  console.log(JSON.stringify(result, null, 2));
  console.log("======================================");
}

main().catch(error => {
  console.error("ERRO:", error);
  process.exitCode = 1;
});
EOF

