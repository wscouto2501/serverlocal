cat > scripts/reserves.js <<'EOF'
const hre = require("hardhat");
const fs = require("fs");
const path = require("path");

async function main() {

    const file = path.join(
        __dirname,
        "../deployments/polygon.json"
    );

    if (!fs.existsSync(file)) {
        throw new Error("Contrato ainda não implantado.");
    }

    const deployment = JSON.parse(
        fs.readFileSync(file, "utf8")
    );

    const network = await hre.ethers.provider.getNetwork();

    if (network.chainId !== 137n) {
        throw new Error("Rede incorreta.");
    }

    const abi = [
        "function name() view returns (string)",
        "function symbol() view returns (string)",
        "function decimals() view returns (uint8)",
        "function totalSupply() view returns (uint256)",
        "function reserveBalance() view returns (uint256)",
        "function reserveRatio() view returns (uint256)",
        "function collateralToken() view returns (address)"
    ];

    const token = new hre.ethers.Contract(
        deployment.contractAddress,
        abi,
        hre.ethers.provider
    );

    const [
        name,
        symbol,
        decimals,
        supply,
        reserves,
        ratio,
        collateral
    ] = await Promise.all([
        token.name(),
        token.symbol(),
        token.decimals(),
        token.totalSupply(),
        token.reserveBalance(),
        token.reserveRatio(),
        token.collateralToken()
    ]);

    console.log("");
    console.log("======================================");
    console.log("RELATÓRIO DE RESERVAS");
    console.log("======================================");

    console.log("Moeda:", name);
    console.log("Símbolo:", symbol);
    console.log("Contrato:", deployment.contractAddress);
    console.log("Referência:", deployment.collateralSymbol);
    console.log("Colateral:", collateral);

    console.log(
        "Supply:",
        hre.ethers.formatUnits(supply, decimals)
    );

    console.log(
        "Reservas:",
        hre.ethers.formatUnits(reserves, decimals)
    );

    console.log(
        "Cobertura:",
        `${(Number(ratio) / 100).toFixed(2)}%`
    );

    console.log("======================================");
}

main().catch(error => {
    console.error("ERRO:", error);
    process.exitCode = 1;
});
EOF

