const { expect } = require("chai");
const { ethers } = require("hardhat");

describe("Stablecoin lastreada em USDC", function () {

  async function setup() {

    const [owner, user, other] = await ethers.getSigners();

    const Mock = await ethers.getContractFactory("MockUSDC");
    const usdc = await Mock.deploy();

    await usdc.waitForDeployment();

    const Factory = await ethers.getContractFactory("Stablecoin");

    const token = await Factory.deploy(
      "RealDollar",
      "RUSD",
      await usdc.getAddress()
    );

    await token.waitForDeployment();

    return { owner, user, other, usdc, token };
  }

  const amount = 1000n * 10n ** 6n;

  it("inicia sem emissão de tokens", async function () {

    const { token } = await setup();

    expect(await token.totalSupply()).to.equal(0n);
  });

  it("utiliza 6 casas decimais", async function () {

    const { token } = await setup();

    expect(await token.decimals()).to.equal(6n);
  });

  it("emite somente após receber USDC", async function () {

    const { user, usdc, token } = await setup();

    await usdc.mint(user.address, amount);

    await usdc.connect(user).approve(
      await token.getAddress(),
      amount
    );

    await token.connect(user).deposit(amount);

    expect(await token.balanceOf(user.address))
      .to.equal(amount);

    expect(await token.totalSupply())
      .to.equal(amount);

    expect(await token.reserveBalance())
      .to.equal(amount);
  });

  it("permite resgatar e queimar os tokens", async function () {

    const { user, usdc, token } = await setup();

    await usdc.mint(user.address, amount);

    await usdc.connect(user).approve(
      await token.getAddress(),
      amount
    );

    await token.connect(user).deposit(amount);

    const balanceBefore = await usdc.balanceOf(user.address);

    await token.connect(user).redeem(amount);

    const balanceAfter = await usdc.balanceOf(user.address);

    expect(balanceAfter - balanceBefore).to.equal(amount);

    expect(await token.totalSupply()).to.equal(0n);

    expect(await token.reserveBalance()).to.equal(0n);
  });

  it("impede emissão sem depósito", async function () {

    const { user, token } = await setup();

    await expect(
      token.connect(user).deposit(amount)
    ).to.be.reverted;
  });

  it("impede resgate acima do saldo", async function () {

    const { user, token } = await setup();

    await expect(
      token.connect(user).redeem(amount)
    ).to.be.revertedWith("Insufficient reserves");
  });

  it("impede depósito de valor zero", async function () {

    const { user, token } = await setup();

    await expect(
      token.connect(user).deposit(0)
    ).to.be.revertedWith("Amount must be positive");
  });

  it("mantém cobertura de 100% após depósito", async function () {

    const { user, usdc, token } = await setup();

    await usdc.mint(user.address, amount);

    await usdc.connect(user).approve(
      await token.getAddress(),
      amount
    );

    await token.connect(user).deposit(amount);

    expect(await token.reserveRatio()).to.equal(10000n);
  });

  it("permite pausa somente ao proprietário", async function () {

    const { owner, user, token } = await setup();

    await expect(
      token.connect(user).pause()
    ).to.be.reverted;

    await token.connect(owner).pause();

    expect(await token.paused()).to.equal(true);

    await expect(
      token.connect(user).deposit(amount)
    ).to.be.revertedWithCustomError(token, "EnforcedPause");
  });

  it("permite retomar operações pelo proprietário", async function () {

    const { owner, token } = await setup();

    await token.pause();
    await token.unpause();

    expect(await token.paused()).to.equal(false);
  });

  it("não permite retirar o USDC por uma função administrativa", async function () {

    const { token } = await setup();

    expect(token.withdrawCollateral).to.equal(undefined);
    expect(token.mint).to.equal(undefined);
  });

});
EOF

