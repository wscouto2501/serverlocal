cat > test/Stablecoin.js <<'EOF'
const { expect } = require("chai");
const { ethers } = require("hardhat");

describe("Stablecoin com colateral configurável", function () {

    async function setup(decimals = 6) {

        const [owner, user, other] = await ethers.getSigners();

        const Mock = await ethers.getContractFactory(
            "MockCollateral"
        );

        const collateral = await Mock.deploy(
            "Mock Reference",
            "MREF",
            decimals
        );

        await collateral.waitForDeployment();

        const Factory = await ethers.getContractFactory(
            "Stablecoin"
        );

        const token = await Factory.deploy(
            "My Stablecoin",
            "MYST",
            await collateral.getAddress()
        );

        await token.waitForDeployment();

        return {
            owner,
            user,
            other,
            collateral,
            token,
            decimals
        };
    }

    it("inicia com supply zero", async function () {

        const { token } = await setup();

        expect(await token.totalSupply()).to.equal(0n);
    });

    it("herda os decimais do colateral", async function () {

        const { token } = await setup(6);

        expect(await token.decimals()).to.equal(6n);
    });

    it("também suporta referência com 18 decimais", async function () {

        const { token } = await setup(18);

        expect(await token.decimals()).to.equal(18n);
    });

    it("emite somente após receber o colateral", async function () {

        const { user, collateral, token } = await setup();

        const amount = 1000n * 10n ** 6n;

        await collateral.mint(user.address, amount);

        await collateral.connect(user).approve(
            await token.getAddress(),
            amount
        );

        await token.connect(user).deposit(amount);

        expect(await token.balanceOf(user.address))
            .to.equal(amount);

        expect(await token.totalSupply())
            .to.equal(amount);

        expect(await token.reserveBalance())
            .to.equal(amount);
    });

    it("permite resgatar e queimar os tokens", async function () {

        const { user, collateral, token } = await setup();

        const amount = 1000n * 10n ** 6n;

        await collateral.mint(user.address, amount);

        await collateral.connect(user).approve(
            await token.getAddress(),
            amount
        );

        await token.connect(user).deposit(amount);

        const before = await collateral.balanceOf(user.address);

        await token.connect(user).redeem(amount);

        const after = await collateral.balanceOf(user.address);

        expect(after - before).to.equal(amount);

        expect(await token.totalSupply()).to.equal(0n);

        expect(await token.reserveBalance()).to.equal(0n);
    });

    it("impede depósito sem colateral", async function () {

        const { user, token } = await setup();

        await expect(
            token.connect(user).deposit(1000000n)
        ).to.be.reverted;
    });

    it("impede depósito de valor zero", async function () {

        const { user, token } = await setup();

        await expect(
            token.connect(user).deposit(0)
        ).to.be.revertedWith("Amount must be positive");
    });

    it("impede resgate de valor zero", async function () {

        const { user, token } = await setup();

        await expect(
            token.connect(user).redeem(0)
        ).to.be.revertedWith("Amount must be positive");
    });

    it("calcula cobertura de 100%", async function () {

        const { user, collateral, token } = await setup();

        const amount = 500n * 10n ** 6n;

        await collateral.mint(user.address, amount);

        await collateral.connect(user).approve(
            await token.getAddress(),
            amount
        );

        await token.connect(user).deposit(amount);

        expect(await token.reserveRatio()).to.equal(10000n);
    });

    it("somente o proprietário pode pausar", async function () {

        const { user, token } = await setup();

        await expect(
            token.connect(user).pause()
        ).to.be.reverted;

        await token.pause();

        expect(await token.paused()).to.equal(true);
    });

    it("impede depósito quando pausado", async function () {

        const { user, token } = await setup();

        await token.pause();

        await expect(
            token.connect(user).deposit(1000000n)
        ).to.be.revertedWithCustomError(token, "EnforcedPause");
    });

    it("permite ao proprietário retomar operações", async function () {

        const { token } = await setup();

        await token.pause();

        await token.unpause();

        expect(await token.paused()).to.equal(false);
    });

});
EOF

