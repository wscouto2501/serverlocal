cat > scripts/deploy.js <<'EOF'
const hre = require("hardhat");
const fs = require("fs");
const path = require("path");

async function main() {

    const configPath = path.join(
        __dirname,
        "../.stablecoin-config.json"
    );

    const cfg = JSON.parse(
        fs.readFileSync(configPath, "utf8")
    );

    if (!process.env.PRIVATE_KEY) {
        throw new Error("PRIVATE_KEY não configurada.");
    }

    const network = await hre.ethers.provider.getNetwork();

    if (network.chainId !== 137n) {
        throw new Error("Rede incorreta. Esperado Polygon.");
    }

    const [deployer] = await hre.ethers.getSigners();

    const balance = await hre.ethers.provider.getBalance(
        deployer.address
    );

    if (balance === 0n) {
        throw new Error("Carteira sem POL para pagar gas.");
    }

    if (!hre.ethers.isAddress(cfg.collateral)) {
        throw new Error("Endereço de referência inválido.");
    }

    const code = await hre.ethers.provider.getCode(
        cfg.collateral
    );

    if (code === "0x") {
        throw new Error("Contrato de referência inexistente.");
    }

    const reference = new hre.ethers.Contract(
        cfg.collateral,
        [
            "function symbol() view returns (string)",
            "function decimals() view returns (uint8)",
            "function balanceOf(address) view returns (uint256)"
        ],
        hre.ethers.provider
    );

    const [symbol, decimals] = await Promise.all([
        reference.symbol(),
        reference.decimals()
    ]);

    if (symbol.toLowerCase() !== cfg.collateralSymbol.toLowerCase()) {
        throw new Error(
            `Símbolo incorreto. Informado: ${cfg.collateralSymbol}; encontrado: ${symbol}`
        );
    }

    if (decimals > 18n) {
        throw new Error("Token de referência possui decimais não suportados.");
    }

    cfg.decimals = Number(decimals);

    fs.writeFileSync(
        configPath,
        JSON.stringify(cfg, null, 2) + "\n",
        { mode: 0o600 }
    );

    console.log("");
    console.log("======================================");
    console.log("IMPLANTAÇÃO DA STABLECOIN");
    console.log("======================================");

    console.log("Nome:", cfg.name);
    console.log("Símbolo:", cfg.symbol);
    console.log("Referência:", symbol);
    console.log("Contrato de referência:", cfg.collateral);
    console.log("Decimais:", cfg.decimals);
    console.log("Carteira:", deployer.address);
    console.log("Saldo POL:", hre.ethers.formatEther(balance));
    console.log("Supply inicial: ZERO");

    const Factory = await hre.ethers.getContractFactory(
        "Stablecoin"
    );

    const token = await Factory.deploy(
        cfg.name,
        cfg.symbol,
        cfg.collateral
    );

    await token.waitForDeployment();

    const address = await token.getAddress();

    const tx = token.deploymentTransaction();

    const result = {
        network: "Polygon Mainnet",
        chainId: 137,
        name: cfg.name,
        symbol: cfg.symbol,
        decimals: cfg.decimals,
        collateralSymbol: symbol,
        collateralAddress: cfg.collateral,
        deployer: deployer.address,
        contractAddress: address,
        transactionHash: tx.hash,
        explorer: `https://polygonscan.com/address/${address}`,
        deployedAt: new Date().toISOString()
    };

    const output = path.join(
        __dirname,
        "../deployments/polygon.json"
    );

    fs.writeFileSync(
        output,
        JSON.stringify(result, null, 2),
        { mode: 0o600 }
    );

    console.log("");
    console.log("======================================");
    console.log("CONTRATO IMPLANTADO");
    console.log("======================================");

    console.log(JSON.stringify(result, null, 2));

    console.log("======================================");
}

main().catch(error => {
    console.error("ERRO:", error);
    process.exitCode = 1;
});
EOF

