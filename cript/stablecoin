// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/Pausable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

contract Stablecoin is
    ERC20,
    Ownable,
    Pausable,
    ReentrancyGuard
{
    using SafeERC20 for IERC20Metadata;

    IERC20Metadata public immutable collateralToken;

    uint8 private immutable tokenDecimals;

    event Deposited(
        address indexed account,
        uint256 amount
    );

    event Redeemed(
        address indexed account,
        uint256 amount
    );

    constructor(
        string memory tokenName,
        string memory tokenSymbol,
        address collateralAddress
    )
        ERC20(tokenName, tokenSymbol)
        Ownable(msg.sender)
    {
        require(
            collateralAddress != address(0),
            "Invalid collateral"
        );

        require(
            collateralAddress.code.length > 0,
            "Collateral is not a contract"
        );

        uint8 referenceDecimals =
            IERC20Metadata(collateralAddress).decimals();

        require(
            referenceDecimals <= 18,
            "Unsupported collateral decimals"
        );

        collateralToken = IERC20Metadata(collateralAddress);

        tokenDecimals = referenceDecimals;
    }

    // A moeda própria utiliza exatamente os mesmos
    // decimais do token de referência.

    function decimals()
        public
        view
        override
        returns (uint8)
    {
        return tokenDecimals;
    }

    // ========================================================
    // DEPÓSITO
    // 1 unidade recebida = 1 unidade emitida.
    // ========================================================

    function deposit(uint256 amount)
        external
        nonReentrant
        whenNotPaused
    {
        require(amount > 0, "Amount must be positive");

        uint256 balanceBefore =
            collateralToken.balanceOf(address(this));

        collateralToken.safeTransferFrom(
            msg.sender,
            address(this),
            amount
        );

        uint256 balanceAfter =
            collateralToken.balanceOf(address(this));

        require(
            balanceAfter >= balanceBefore,
            "Invalid collateral balance"
        );

        require(
            balanceAfter - balanceBefore == amount,
            "Unexpected collateral received"
        );

        _mint(msg.sender, amount);

        emit Deposited(msg.sender, amount);
    }

    // ========================================================
    // RESGATE
    // 1 unidade queimada = 1 unidade devolvida.
    // ========================================================

    function redeem(uint256 amount)
        external
        nonReentrant
        whenNotPaused
    {
        require(amount > 0, "Amount must be positive");

        require(
            collateralToken.balanceOf(address(this)) >= amount,
            "Insufficient reserves"
        );

        _burn(msg.sender, amount);

        collateralToken.safeTransfer(
            msg.sender,
            amount
        );

        emit Redeemed(msg.sender, amount);
    }

    // ========================================================
    // INFORMAÇÕES DAS RESERVAS
    // ========================================================

    function reserveBalance()
        public
        view
        returns (uint256)
    {
        return collateralToken.balanceOf(address(this));
    }

    function reserveRatio()
        external
        view
        returns (uint256)
    {
        uint256 supply = totalSupply();

        if (supply == 0) {
            return 0;
        }

        return (reserveBalance() * 10000) / supply;
    }

    // ========================================================
    // CONTROLE EMERGENCIAL
    // ========================================================

    function pause() external onlyOwner {
        _pause();
    }

    function unpause() external onlyOwner {
        _unpause();
    }

    // NÃO EXISTE:
    // - Mint administrativo.
    // - Retirada administrativa de colateral.
    // - Alteração do endereço de colateral.
    //
    // A emissão depende exclusivamente de depósitos.
}
EOF

