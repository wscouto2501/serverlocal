#!/bin/bash
set -Eeuo pipefail

# ============================================================
# STABLECOIN PERSONALIZADA - POLYGON
#
# COLATERAL CONFIGURÁVEL
#
# Exemplos:
# USDC  -> moeda própria lastreada em USDC
# EURC  -> moeda própria lastreada em EURC
# DAI   -> moeda própria lastreada em DAI
# WETH  -> moeda própria lastreada em WETH
#
# Regras:
# - O usuário escolhe o token ERC-20 de referência.
# - Os decimais são consultados automaticamente.
# - 1 unidade da moeda de referência gera 1 unidade
#   da moeda própria, usando as mesmas casas decimais.
# - Depósito emite.
# - Resgate queima e devolve o colateral.
# - Não existe mint administrativo.
# - Não existe retirada administrativa de reservas.
# - Supply inicial ZERO.
#
# ATENÇÃO:
# A paridade é com o TOKEN escolhido, não necessariamente
# com a moeda fiduciária que ele representa.
# ============================================================

if [[ "${EUID}" -ne 0 ]]; then
    echo "Execute como root:"
    echo "sudo bash instalar_stablecoin.sh"
    exit 1
fi

# ============================================================
# DEPENDÊNCIAS DO SISTEMA
# ============================================================

if ! command -v node >/dev/null 2>&1 || \
   ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)' 2>/dev/null; then

    echo "Instalando Node.js 20..."

    apt-get update
    apt-get install -y ca-certificates curl

    curl -fsSL https://deb.nodesource.com/setup_20.x \
        -o /tmp/nodesource_setup.sh

    bash /tmp/nodesource_setup.sh

    apt-get install -y nodejs

    rm -f /tmp/nodesource_setup.sh
fi

apt-get install -y iconv

echo
echo "Node.js: $(node -v)"
echo "NPM: $(npm -v)"

# ============================================================
# CONFIGURAÇÃO INTERATIVA
# ============================================================

echo
echo "=================================================="
echo "       STABLECOIN PERSONALIZADA"
echo "=================================================="
echo
echo "Rede: Polygon PoS"
echo "Chain ID: 137"
echo
echo "Você poderá escolher qualquer token ERC-20"
echo "compatível existente na Polygon como referência."
echo
echo "Exemplos: USDC, EURC, DAI, WETH."
echo
echo "Atenção: o contrato não verifica se o token"
echo "realmente possui reservas fiduciárias."
echo

read -r -p "Nome da sua moeda [RealUnit]: " TOKEN_NAME
TOKEN_NAME="${TOKEN_NAME:-RealUnit}"

read -r -p "Símbolo da sua moeda [RUNIT]: " TOKEN_SYMBOL
TOKEN_SYMBOL="${TOKEN_SYMBOL:-RUNIT}"

echo
echo "Informe o endereço do token ERC-20 de referência."
echo "Exemplo: endereço do USDC ou EURC na Polygon."
echo

read -r -p "Endereço do token de referência: " COLLATERAL

read -r -p "Símbolo esperado do token de referência: " COLLATERAL_SYMBOL

read -r -p "Descrição do projeto (opcional): " TOKEN_DESCRIPTION

# ============================================================
# VALIDAÇÕES
# ============================================================

if [[ ! "$TOKEN_NAME" =~ ^[[:print:]]{1,64}$ ]]; then
    echo "ERRO: nome inválido."
    exit 1
fi

if [[ ! "$TOKEN_SYMBOL" =~ ^[A-Za-z0-9]{1,12}$ ]]; then
    echo "ERRO: símbolo inválido."
    exit 1
fi

if [[ ! "$COLLATERAL" =~ ^0x[a-fA-F0-9]{40}$ ]]; then
    echo "ERRO: endereço do colateral inválido."
    exit 1
fi

if [[ "${COLLATERAL,,}" == "0x0000000000000000000000000000000000000000" ]]; then
    echo "ERRO: endereço zero não permitido."
    exit 1
fi

if [[ ! "$COLLATERAL_SYMBOL" =~ ^[A-Za-z0-9._-]{1,20}$ ]]; then
    echo "ERRO: símbolo de referência inválido."
    exit 1
fi

if [[ "${TOKEN_SYMBOL^^}" == "${COLLATERAL_SYMBOL^^}" ]]; then
    echo "ERRO: use um símbolo diferente do token de referência."
    exit 1
fi

# ============================================================
# DIRETÓRIO DO PROJETO
# ============================================================

TOKEN_DIR=$(echo "$TOKEN_NAME" \
    | iconv -f UTF-8 -t ASCII//TRANSLIT \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9]/-/g; s/-\+/-/g; s/^-//; s/-$//')

if [[ -z "$TOKEN_DIR" ]]; then
    echo "ERRO: nome inválido para diretório."
    exit 1
fi

PROJECT_DIR="/root/${TOKEN_DIR}"

if [[ -d "$PROJECT_DIR" ]]; then
    echo "ERRO: diretório já existe: $PROJECT_DIR"
    exit 1
fi

mkdir -p "$PROJECT_DIR"
cd "$PROJECT_DIR"

mkdir -p contracts scripts test deployments logs

# ============================================================
# CONFIGURAÇÃO DO PROJETO
# ============================================================

TOKEN_NAME="$TOKEN_NAME" \
TOKEN_SYMBOL="$TOKEN_SYMBOL" \
COLLATERAL="$COLLATERAL" \
COLLATERAL_SYMBOL="$COLLATERAL_SYMBOL" \
TOKEN_DESCRIPTION="$TOKEN_DESCRIPTION" \
node <<'NODE'
const fs = require("fs");

const config = {
    name: process.env.TOKEN_NAME,
    symbol: process.env.TOKEN_SYMBOL,
    collateral: process.env.COLLATERAL,
    collateralSymbol: process.env.COLLATERAL_SYMBOL,
    decimals: null,
    description: process.env.TOKEN_DESCRIPTION || "",
    network: "Polygon",
    chainId: 137
};

fs.writeFileSync(
    ".stablecoin-config.json",
    JSON.stringify(config, null, 2) + "\n",
    { mode: 0o600 }
);
NODE

echo
echo "=================================================="
echo "CONFIGURAÇÃO"
echo "=================================================="
echo "Nome: $TOKEN_NAME"
echo "Símbolo: $TOKEN_SYMBOL"
echo "Token de referência: $COLLATERAL_SYMBOL"
echo "Contrato de referência: $COLLATERAL"
echo "Rede: Polygon"
echo "Supply inicial: ZERO"
echo "=================================================="

read -r -p "Confirma a configuração? (s/N): " CONFIRM

if [[ ! "$CONFIRM" =~ ^[Ss]$ ]]; then
    echo "Configuração cancelada."
    exit 1
fi

