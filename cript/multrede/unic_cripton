cat > test/MeuToken.js <<'EOF'
const { expect } = require("chai");
const { ethers } = require("hardhat");
const config = require("../.token-config.json");

describe("MeuToken personalizavel", function () {

    async function deployToken(options = {}) {
        const [owner, other] = await ethers.getSigners();

        const Token = await ethers.getContractFactory("MeuToken");

        const token = await Token.deploy(
            options.name || "Minha Moeda",
            options.symbol || "MMC",
            options.supply || "10000000",
            options.decimals ?? 18,
            options.holder || owner.address,
            ethers.hexlify(ethers.randomBytes(32)),
            ethers.hexlify(ethers.randomBytes(32)),
            owner.address
        );

        await token.waitForDeployment();

        return { token, owner, other };
    }

    it("armazena um identificador único não nulo", async function () {
        const { token } = await deployToken();

        expect(await token.tokenId()).to.match(/^0x[0-9a-fA-F]{64}$/);
        expect(await token.tokenId()).to.not.equal(ethers.ZeroHash);
    });

    it("armazena um fingerprint único não nulo", async function () {
        const { token } = await deployToken();

        expect(await token.uniqueFingerprint())
            .to.match(/^0x[0-9a-fA-F]{64}$/);

        expect(await token.uniqueFingerprint())
            .to.not.equal(ethers.ZeroHash);
    });

    it("emite a quantidade inicial para a carteira escolhida", async function () {
        const { token, owner } = await deployToken({
            supply: "2500"
        });

        expect(await token.balanceOf(owner.address))
            .to.equal(ethers.parseUnits("2500", 18));

        expect(await token.totalSupply())
            .to.equal(ethers.parseUnits("2500", 18));
    });

    it("usa as casas decimais configuradas", async function () {
        const { token } = await deployToken({ decimals: 6 });

        expect(await token.decimals()).to.equal(6);

        expect(await token.totalSupply())
            .to.equal(10_000_000n * 10n ** 6n);
    });

    // ---------------- MINT ----------------

    if (config.mintEnabled === true) {

        it("possui mint quando habilitado", async function () {
            const { token, other } = await deployToken();

            expect(token.interface.hasFunction("mint"))
                .to.equal(true);

            await token.mint(other.address, 100n);

            expect(await token.balanceOf(other.address))
                .to.equal(100n);
        });

        it("permite mint somente pelo proprietário", async function () {
            const { token, other } = await deployToken();

            await expect(
                token.connect(other).mint(other.address, 100n)
            ).to.be.reverted;
        });

    } else {

        it("não possui mint quando desabilitado", async function () {
            const { token } = await deployToken();

            expect(token.interface.hasFunction("mint"))
                .to.equal(false);
        });

    }

    // ---------------- BURN ----------------

    if (config.burnEnabled === true) {

        it("possui burn quando habilitado", async function () {
            const { token, owner } = await deployToken();

            expect(token.interface.hasFunction("burn"))
                .to.equal(true);

            const initialBalance = await token.balanceOf(owner.address);
            const amount = ethers.parseUnits("100", 18);

            await token.burn(amount);

            expect(await token.balanceOf(owner.address))
                .to.equal(initialBalance - amount);
        });

    } else {

        it("não possui burn quando desabilitado", async function () {
            const { token } = await deployToken();

            expect(token.interface.hasFunction("burn"))
                .to.equal(false);
        });

    }

});
