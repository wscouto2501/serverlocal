cat > "${PROJECT_DIR}/validar_moeda.js" <<'JS_EOF'
const { ethers } = require("ethers");
const fs = require("fs");

async function main() {
    const rpcUrl = process.env.RPC_URL;
    const tokenAddress = process.env.TOKEN_ADDRESS;

    if (!rpcUrl || !tokenAddress) {
        throw new Error("RPC_URL e TOKEN_ADDRESS são obrigatórios.");
    }

    if (!ethers.isAddress(tokenAddress)) {
        throw new Error("Endereço de contrato inválido.");
    }

    const address = ethers.getAddress(tokenAddress);

    console.log("\n============================================");
    console.log("        AUDITORIA BÁSICA DO TOKEN");
    console.log("============================================\n");

    const provider = new ethers.JsonRpcProvider(rpcUrl);
    const network = await provider.getNetwork();

    console.log("[OK] Conexão com a blockchain.");
    console.log(`Chain ID: ${network.chainId}`);

    const blockNumber = await provider.getBlockNumber();

    console.log(`Bloco atual: ${blockNumber}`);

    const code = await provider.getCode(address);

    if (code === "0x") {
        throw new Error("Nenhum contrato encontrado neste endereço.");
    }

    console.log("\n[OK] Contrato encontrado.");
    console.log(`Endereço: ${address}`);
    console.log(`Bytecode: ${(code.length - 2) / 2} bytes`);

    const abi = [
        "function name() view returns (string)",
        "function symbol() view returns (string)",
        "function decimals() view returns (uint8)",
        "function totalSupply() view returns (uint256)",
        "function owner() view returns (address)"
    ];

    const token = new ethers.Contract(address, abi, provider);

    const result = {
        chainId: network.chainId.toString(),
        blockNumber,
        address,
        bytecodeBytes: (code.length - 2) / 2,
        name: null,
        symbol: null,
        decimals: null,
        totalSupply: null,
        owner: null,
        mintEnabled: null,
        burnEnabled: null,
        checks: {}
    };

    // ---------------- Dados ERC-20 ----------------

    console.log("\n============================================");
    console.log("             DADOS DO TOKEN");
    console.log("============================================");

    try {
        result.name = await token.name();
        result.checks.name = true;
        console.log(`Nome: ${result.name}`);
    } catch {
        result.checks.name = false;
        console.log("[AVISO] Nome não disponível.");
    }

    try {
        result.symbol = await token.symbol();
        result.checks.symbol = true;
        console.log(`Símbolo: ${result.symbol}`);
    } catch {
        result.checks.symbol = false;
        console.log("[AVISO] Símbolo não disponível.");
    }

    try {
        result.decimals = Number(await token.decimals());
        result.checks.decimals = true;
        console.log(`Decimais: ${result.decimals}`);
    } catch {
        result.checks.decimals = false;
        console.log("[AVISO] Decimais não disponíveis.");
    }

    try {
        const supply = await token.totalSupply();

        result.totalSupply = supply.toString();
        result.checks.totalSupply = true;

        const formatted = result.decimals !== null
            ? ethers.formatUnits(supply, result.decimals)
            : supply.toString();

        console.log(`Supply: ${formatted} ${result.symbol || ""}`);
    } catch {
        result.checks.totalSupply = false;
        console.log("[AVISO] Supply não disponível.");
    }

    // ---------------- Administração ----------------

    console.log("\n============================================");
    console.log("              ADMINISTRAÇÃO");
    console.log("============================================");

    try {
        result.owner = await token.owner();
        result.checks.owner = true;
        console.log(`Proprietário: ${result.owner}`);
    } catch {
        result.checks.owner = false;
        console.log("Contrato não disponibiliza owner().");
    }

    // ========================================================
    // VERIFICAÇÃO REAL DAS FUNÇÕES MINT E BURN
    //
    // O contrato não possui mintEnabled() ou burnEnabled().
    // Por isso, a verificação utiliza chamadas eth_call.
    //
    // Não executa transações e não altera o contrato.
    // ========================================================

    const functionInterface = new ethers.Interface([
        "function mint(address to, uint256 amount)",
        "function burn(uint256 amount)"
    ]);

    async function checkFunction(functionName, args, from) {
        try {
            const data = functionInterface.encodeFunctionData(
                functionName,
                args
            );

            await provider.call({
                to: address,
                from,
                data
            });

            return true;
        } catch {
            return false;
        }
    }

    console.log("\n============================================");
    console.log("          FUNÇÕES DO CONTRATO");
    console.log("============================================");

    if (result.owner) {
        // Mint é chamado pelo proprietário, com quantidade zero.
        // Isso permite verificar se a função existe e está acessível.
        result.mintEnabled = await checkFunction(
            "mint",
            [result.owner, 0n],
            result.owner
        );

        // Burn é chamado pelo proprietário, com quantidade zero.
        // A chamada é somente leitura e não queima tokens.
        result.burnEnabled = await checkFunction(
            "burn",
            [0n],
            result.owner
        );

        result.checks.mintEnabled = true;
        result.checks.burnEnabled = true;

        console.log(
            `Mint: ${result.mintEnabled ? "PRESENTE" : "AUSENTE"}`
        );

        console.log(
            `Burn: ${result.burnEnabled ? "PRESENTE" : "AUSENTE"}`
        );
    } else {
        result.checks.mintEnabled = false;
        result.checks.burnEnabled = false;

        console.log(
            "Mint: não foi possível verificar sem consultar owner()."
        );

        console.log(
            "Burn: não foi possível verificar sem consultar owner()."
        );
    }

    // ---------------- Relatório ----------------

    const reportPath = process.env.REPORT_FILE;

    if (reportPath) {
        fs.writeFileSync(
            reportPath,
            JSON.stringify(result, null, 2),
            { mode: 0o600 }
        );
    }

    console.log("\n============================================");
    console.log("             RESULTADO");
    console.log("============================================");

    console.log("[OK] Consulta concluída.");
    console.log("[OK] Nenhuma transação executada.");
    console.log("[OK] Nenhuma chave privada utilizada.");
    console.log("[OK] Nenhum arquivo .env modificado.");

    if (result.mintEnabled === true) {
        console.log("[ALERTA] Função Mint presente no contrato.");
    } else if (result.mintEnabled === false) {
        console.log("[OK] Função Mint ausente.");
    }

    if (result.burnEnabled === true) {
        console.log("[ALERTA] Função Burn presente no contrato.");
    } else if (result.burnEnabled === false) {
        console.log("[OK] Função Burn ausente.");
    }

    console.log("\nATENÇÃO:");
    console.log("Esta verificação não substitui uma auditoria");
    console.log("de segurança do código ou do bytecode.");
}

main().catch(err => {
    console.error("\n[ERRO]", err.message);
    process.exit(1);
});
