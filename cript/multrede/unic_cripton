
#!/bin/bash
set -Eeuo pipefail

# ============================================================
# TOKEN PERSONALIZADO - MULTIRREDE EVM
# ============================================================

if [[ "${EUID}" -ne 0 ]]; then
    echo "Execute como root: sudo bash unic_cripton"
    exit 1
fi

# ---------------- Node.js 24 LTS ----------------

NODE_MAJOR=""

if command -v node >/dev/null 2>&1; then
    NODE_MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])')"
fi

# Instala Node.js 24 quando não estiver instalado ou estiver em outra versão.
if [[ "$NODE_MAJOR" != "24" ]]; then

    echo "Instalando Node.js 24 LTS..."

    apt-get update
    apt-get install -y ca-certificates curl

    curl -fsSL https://deb.nodesource.com/setup_24.x \
        -o /tmp/nodesource_setup.sh

    bash /tmp/nodesource_setup.sh

    apt-get install -y nodejs

    rm -f /tmp/nodesource_setup.sh
fi

# Confirma a instalação.
NODE_MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])')"

if [[ "$NODE_MAJOR" != "24" ]]; then
    echo "ERRO: Node.js 24 não foi instalado corretamente."
    exit 1
fi

echo "Node.js: $(node -v)"
echo "NPM: $(npm -v)"




if command -v git >/dev/null 2>&1; then
    echo "[OK] Git já está instalado."
else
    echo "[AVISO] Git não encontrado. Iniciando instalação..."

    if command -v apt-get >/dev/null 2>&1; then
        apt-get update
        apt-get install -y git
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y git
    elif command -v yum >/dev/null 2>&1; then
        yum install -y git
    elif command -v apk >/dev/null 2>&1; then
        apk add git
    else
        echo "[ERRO] Gerenciador de pacotes não identificado."
        exit 1
    fi
fi

echo
echo "================================================"
echo "VERIFICACAO FINAL DO GIT"
echo "================================================"

if command -v git >/dev/null 2>&1; then
    echo "[OK] Git instalado."
    git --version
    echo "Caminho: $(command -v git)"
else
    echo "[ERRO] Não foi possível instalar o Git."
    exit 1
fi




# ---------------- Catálogo de redes ----------------

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PARAM_FILE="${SCRIPT_DIR}/parametro"
PARAM_URL="https://raw.githubusercontent.com/wscouto2501/serverlocal/main/cript/multrede/parametro"

if [[ ! -s "$PARAM_FILE" ]]; then
    echo "Arquivo parametro não encontrado. Baixando do GitHub..."

    curl -fsSL "$PARAM_URL" -o /tmp/unic_cripton_parametro.json || {
        echo "ERRO: não foi possível obter o catálogo de redes."
        exit 1
    }

    PARAM_FILE="/tmp/unic_cripton_parametro.json"
fi

node -e '
const fs = require("fs");
const p = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
if (!Array.isArray(p.networks) || !p.networks.length) {
    throw new Error("Catálogo sem redes.");
}
' "$PARAM_FILE" || {
    echo "ERRO: arquivo parametro inválido."
    exit 1
}

mapfile -t AVAILABLE_NETWORKS < <(
    node - "$PARAM_FILE" <<'NODE'
const fs = require("fs");
const p = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));

for (const n of p.networks) {
    if (
        n.enabled === true &&
        n.deploySupported === true &&
        n.family === "evm" &&
        n.module === "evm"
    ) {
        console.log([
            n.key,
            n.name,
            n.chainId,
            n.nativeCurrency.symbol,
            n.rpc.default,
            n.explorer
        ].join("|"));
    }
}
NODE
)

if [[ "${#AVAILABLE_NETWORKS[@]}" -eq 0 ]]; then
    echo "ERRO: nenhuma rede EVM habilitada para implantação."
    exit 1
fi

echo
echo "=================================================="
echo "          SELECIONE A REDE BLOCKCHAIN"
echo "=================================================="

for i in "${!AVAILABLE_NETWORKS[@]}"; do
    IFS='|' read -r _key _name _chain _native _rpc _explorer \
        <<< "${AVAILABLE_NETWORKS[$i]}"

    printf "%2d) %s (Chain ID: %s | Gas: %s)\n" \
        "$((i+1))" "$_name" "$_chain" "$_native"
done

echo
read -r -p "Número da rede [1]: " NETWORK_CHOICE
NETWORK_CHOICE="${NETWORK_CHOICE:-1}"

if [[ ! "$NETWORK_CHOICE" =~ ^[0-9]+$ ]] ||
   (( NETWORK_CHOICE < 1 || NETWORK_CHOICE > ${#AVAILABLE_NETWORKS[@]} )); then
    echo "ERRO: opção de rede inválida."
    exit 1
fi

IFS='|' read -r \
    NETWORK_KEY \
    NETWORK_NAME \
    NETWORK_CHAIN_ID \
    NATIVE_SYMBOL \
    NETWORK_DEFAULT_RPC \
    NETWORK_EXPLORER \
    <<< "${AVAILABLE_NETWORKS[$((NETWORK_CHOICE-1))]}"

if [[ ! "$NETWORK_CHAIN_ID" =~ ^[0-9]+$ ]] || (( NETWORK_CHAIN_ID == 0 )); then
    echo "ERRO: Chain ID inválido no catálogo."
    exit 1
fi

echo "Rede selecionada: ${NETWORK_NAME} (Chain ID ${NETWORK_CHAIN_ID})"

# ---------------- Dados do token ----------------

echo
echo "=================================================="
echo "       CONFIGURAÇÃO DA SUA CRIPTOMOEDA"
echo "=================================================="



read -r -p "Nome da moeda [RealUnit]: " TOKEN_NAME
TOKEN_NAME="${TOKEN_NAME:-RealUnit}"

read -r -p "Símbolo/ticker [RUT]: " TOKEN_SYMBOL
TOKEN_SYMBOL="${TOKEN_SYMBOL:-RUT}"

# Nome técnico do contrato baseado no símbolo da moeda.
CONTRACT_NAME="${TOKEN_SYMBOL^^}"

# Solidity não permite identificadores iniciados por números.
# Letra no início: adiciona Token no final.
# Número no início: adiciona Token no início.
if [[ "$CONTRACT_NAME" =~ ^[a-zA-Z] ]]; then
    CONTRACT_NAME="${CONTRACT_NAME}Token"
elif [[ "$CONTRACT_NAME" =~ ^[0-9] ]]; then
    CONTRACT_NAME="Token${CONTRACT_NAME}"
fi

CONTRACT_FILE="contracts/${CONTRACT_NAME}.sol"
TEST_FILE="test/${CONTRACT_NAME}.js"





read -r -p "Quantidade inicial de tokens [10000000]: " INITIAL_SUPPLY
INITIAL_SUPPLY="${INITIAL_SUPPLY:-10000000}"

read -r -p "Casas decimais (0 a 18) [18]: " TOKEN_DECIMALS
TOKEN_DECIMALS="${TOKEN_DECIMALS:-18}"

read -r -p "Carteira que receberá a emissão inicial (vazio = carteira implantadora): " INITIAL_HOLDER

read -r -p "Permitir novas emissões pelo administrador? (s/N): " MINT_ANSWER
MINT_ANSWER="${MINT_ANSWER:-N}"

read -r -p "Permitir que titulares queimem seus próprios tokens? (s/N): " BURN_ANSWER
BURN_ANSWER="${BURN_ANSWER:-N}"

read -r -p "Descrição do projeto (opcional): " TOKEN_DESCRIPTION

# ---------------- Validações ----------------

if [[ ! "$TOKEN_NAME" =~ ^[[:print:]]{1,64}$ ]]; then
    echo "ERRO: nome inválido ou maior que 64 caracteres."
    exit 1
fi

if [[ ! "$TOKEN_SYMBOL" =~ ^[A-Za-z0-9]{1,12}$ ]]; then
    echo "ERRO: símbolo deve conter de 1 a 12 letras ou números."
    exit 1
fi

if [[ ! "$INITIAL_SUPPLY" =~ ^[0-9]+$ ]] ||
   [[ ! "$INITIAL_SUPPLY" =~ [1-9] ]]; then
    echo "ERRO: fornecimento inicial deve ser um inteiro maior que zero."
    exit 1
fi

if [[ ! "$TOKEN_DECIMALS" =~ ^([0-9]|1[0-8])$ ]]; then
    echo "ERRO: casas decimais deve ser um número entre 0 e 18."
    exit 1
fi

if [[ -n "$INITIAL_HOLDER" ]] &&
   [[ ! "$INITIAL_HOLDER" =~ ^0x[a-fA-F0-9]{40}$ ]]; then
    echo "ERRO: endereço da carteira inválido."
    exit 1
fi

# Confere o limite de uint256 antes de criar o projeto.
node - "$INITIAL_SUPPLY" "$TOKEN_DECIMALS" <<'NODE'
const supply = BigInt(process.argv[2]);
const decimals = BigInt(process.argv[3]);
const max = (1n << 256n) - 1n;
const multiplier = 10n ** decimals;

if (supply > max) {
    console.error("ERRO: quantidade inicial ultrapassa o limite de uint256.");
    process.exit(1);
}

if (supply > max / multiplier) {
    console.error("ERRO: quantidade inicial multiplicada pelas casas decimais ultrapassa uint256.");
    process.exit(1);
}
NODE

# ---------------- Interpretação Mint/Burn ----------------

parse_yes_no() {
    local answer
    answer="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"

    case "$answer" in
        s|sim)
            echo "true"
            ;;
        n|nao|não|"")
            echo "false"
            ;;
        *)
            echo "ERRO: resposta inválida. Utilize S ou N." >&2
            return 1
            ;;
    esac
}

MINT_ENABLED="$(parse_yes_no "$MINT_ANSWER")" || exit 1
BURN_ENABLED="$(parse_yes_no "$BURN_ANSWER")" || exit 1

# ---------------- Criar diretório ----------------

TOKEN_DIR="$(
    printf '%s' "$TOKEN_NAME" |
    iconv -f UTF-8 -t ASCII//TRANSLIT |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9]/-/g; s/-\+/-/g; s/^-//; s/-$//'
)"

if [[ -z "$TOKEN_DIR" ]]; then
    echo "ERRO: nome inválido para criar o diretório."
    exit 1
fi

PROJECT_DIR="/root/$TOKEN_DIR"

if [[ -e "$PROJECT_DIR" ]]; then
    echo "ERRO: o caminho $PROJECT_DIR já existe."
    exit 1
fi

mkdir -p "$PROJECT_DIR"
cd "$PROJECT_DIR"

mkdir -p contracts scripts test deployments

echo
echo "=========================================="
echo "PROJETO CRIADO"
echo "=========================================="
echo "Nome: $TOKEN_NAME"
echo "Símbolo: $TOKEN_SYMBOL"
echo "Diretório: $PROJECT_DIR"
echo "=========================================="

# ---------------- Configuração JSON ----------------

TOKEN_NAME="$TOKEN_NAME" \
TOKEN_SYMBOL="$TOKEN_SYMBOL" \
CONTRACT_NAME="$CONTRACT_NAME" \
INITIAL_SUPPLY="$INITIAL_SUPPLY" \
TOKEN_DECIMALS="$TOKEN_DECIMALS" \
INITIAL_HOLDER="$INITIAL_HOLDER" \
MINT_ENABLED="$MINT_ENABLED" \
BURN_ENABLED="$BURN_ENABLED" \
TOKEN_DESCRIPTION="$TOKEN_DESCRIPTION" \
NETWORK_KEY="$NETWORK_KEY" \
NETWORK_NAME="$NETWORK_NAME" \
NETWORK_CHAIN_ID="$NETWORK_CHAIN_ID" \
NATIVE_SYMBOL="$NATIVE_SYMBOL" \
NETWORK_EXPLORER="$NETWORK_EXPLORER" \
node <<'NODE'
const fs = require("fs");

const config = {
    name: process.env.TOKEN_NAME,
    symbol: process.env.TOKEN_SYMBOL,
    contractName: process.env.CONTRACT_NAME,
    initialSupply: process.env.INITIAL_SUPPLY,
    decimals: Number(process.env.TOKEN_DECIMALS),
    initialHolder: process.env.INITIAL_HOLDER || "",
    mintEnabled: process.env.MINT_ENABLED === "true",
    burnEnabled: process.env.BURN_ENABLED === "true",
    description: process.env.TOKEN_DESCRIPTION || "",
    network: {
        key: process.env.NETWORK_KEY,
        name: process.env.NETWORK_NAME,
        family: "evm",
        module: "evm",
        chainId: Number(process.env.NETWORK_CHAIN_ID),
        nativeSymbol: process.env.NATIVE_SYMBOL,
        explorer: process.env.NETWORK_EXPLORER
    }
};

fs.writeFileSync(
    ".token-config.json",
    JSON.stringify(config, null, 2) + "\n",
    { mode: 0o600 }
);
NODE

chmod 600 .token-config.json

# ---------------- Resumo ----------------

echo
echo "---------------- RESUMO ----------------"

node <<'NODE'
const c = require("./.token-config.json");

console.log("Nome:", c.name);
console.log("Símbolo:", c.symbol);
console.log("Nome técnico do contrato:", c.contractName);
console.log("Arquivo Solidity:", `contracts/${c.contractName}.sol`);
console.log("Arquivo de testes:", `test/${c.contractName}.js`);
console.log("Emissão inicial:", c.initialSupply);
console.log("Casas decimais:", c.decimals);
console.log("Carteira inicial:", c.initialHolder || "Carteira implantadora");
console.log("Novas emissões:", c.mintEnabled ? "Permitidas" : "Desativadas");
console.log("Queima:", c.burnEnabled ? "Ativada" : "Desativada");
console.log("Descrição:", c.description || "(não informada)");
console.log("Rede:", c.network.name);
NODE

echo "----------------------------------------"

read -r -p "Confirma essa configuração? (s/N): " CONFIRM

if [[ ! "$CONFIRM" =~ ^[Ss]$ ]]; then
    echo "Configuração cancelada."
    exit 1
fi

# ---------------- package.json ----------------

cat > package.json <<'EOF'
{
  "name": "token-personalizado-multirede",
  "version": "1.2.0",
  "private": true,
  "description": "Criador de tokens ERC20 em redes EVM",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network selected"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "dotenv": "16.4.5",
    "hardhat": "2.28.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "ethers": "^6.13.0"
  }
}
EOF

# ============================================================
# CONTRATO ERC20
# Mint e Burn são incluídos somente quando habilitados.
# ============================================================

cat > "$CONTRACT_FILE" <<EOF
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.39;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract ${CONTRACT_NAME} is ERC20, Ownable {
    uint8 private immutable _customDecimals;

    bytes32 public immutable tokenId;
    bytes32 public immutable uniqueFingerprint;
   
    constructor(
        string memory tokenName,
        string memory tokenSymbol,
        uint256 initialSupply,
        uint8 tokenDecimals,
        address initialHolder,
        bytes32 uniqueTokenId,
        bytes32 _uniqueFingerprint,
        address tokenOwner
    ) ERC20(tokenName, tokenSymbol) Ownable(tokenOwner) {
        require(initialHolder != address(0), "Invalid initial holder");
        require(tokenDecimals <= 18, "Decimals above 18");
        require(uniqueTokenId != bytes32(0), "Invalid token ID");
        require(_uniqueFingerprint != bytes32(0), "Invalid fingerprint");

        _customDecimals = tokenDecimals;
        tokenId = uniqueTokenId;
        uniqueFingerprint = _uniqueFingerprint;

        uint256 multiplier = 10 ** uint256(tokenDecimals);

        require(
            initialSupply <= type(uint256).max / multiplier,
            "Initial supply overflow"
        );

        _mint(initialHolder, initialSupply * multiplier);
    }

    function decimals() public view override returns (uint8) {
        return _customDecimals;
    }
EOF

# ---------------- Mint condicional ----------------

if [[ "$MINT_ENABLED" == "true" ]]; then
    cat >> "$CONTRACT_FILE" <<'EOF'

    // Mint: somente o proprietário pode emitir novos tokens.
    function mint(address to, uint256 amount) external onlyOwner {
        require(to != address(0), "Invalid recipient");
        _mint(to, amount);
    }
EOF
fi

# ---------------- Burn condicional ----------------

if [[ "$BURN_ENABLED" == "true" ]]; then
    cat >> "$CONTRACT_FILE" <<'EOF'

    // Burn: cada titular pode queimar seus próprios tokens.
    function burn(uint256 amount) external {
        _burn(msg.sender, amount);
    }
EOF
fi

echo "}" >> "$CONTRACT_FILE"




# ============================================================
# FÁBRICA DE TOKENS - CREATE2
# ============================================================

cat > contracts/TokenFactory.sol <<EOF
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.39;

import "./${CONTRACT_NAME}.sol";

contract TokenFactory {

    event TokenDeployed(
        address indexed tokenAddress,
        address indexed owner,
        bytes32 indexed salt
    );

    function deployToken(
        string memory tokenName,
        string memory tokenSymbol,
        uint256 initialSupply,
        uint8 tokenDecimals,
        address initialHolder,
        bytes32 uniqueTokenId,
        bytes32 uniqueFingerprint,
        bytes32 salt
    ) external returns (address) {

        // CREATE2 cria o token utilizando um salt exclusivo.
        // O proprietário será a carteira que chamou a fábrica.
        ${CONTRACT_NAME} token = new ${CONTRACT_NAME}{salt: salt}(
            tokenName,
            tokenSymbol,
            initialSupply,
            tokenDecimals,
            initialHolder,
            uniqueTokenId,
            uniqueFingerprint,
            msg.sender
        );

        address tokenAddress = address(token);

        emit TokenDeployed(
            tokenAddress,
            msg.sender,
            salt
        );

        return tokenAddress;
    }
}
EOF












# ============================================================
# HARDHAT
# ============================================================

cat > hardhat.config.js <<'EOF'
