cat > scripts/deploy.js <<'EOF'
const hre = require("hardhat");
const fs = require("fs");
const path = require("path");

async function main() {
    if (!process.env.PRIVATE_KEY) {
        throw new Error("PRIVATE_KEY não configurada no .env.");
    }

    const configPath = path.join(__dirname, "../.token-config.json");

    if (!fs.existsSync(configPath)) {
        throw new Error(".token-config.json não encontrado.");
    }

    const cfg = JSON.parse(fs.readFileSync(configPath, "utf8"));
    const selected = cfg.network;

    if (!selected || selected.family !== "evm" || selected.module !== "evm") {
        throw new Error("Esta versão suporta somente redes EVM.");
    }

    const network = await hre.ethers.provider.getNetwork();
    const expectedChainId = BigInt(selected.chainId);

    if (network.chainId !== expectedChainId) {
        throw new Error(
            `Rede incorreta: ${network.chainId}. Esperado: ${expectedChainId}.`
        );
    }

    const [deployer] = await hre.ethers.getSigners();

    if (!deployer) {
        throw new Error("Carteira de implantação não carregada.");
    }

    const balance = await hre.ethers.provider.getBalance(deployer.address);

    if (balance === 0n) {
        throw new Error(
            `A carteira não possui ${selected.nativeSymbol} para pagar o gas.`
        );
    }

    const initialHolder = cfg.initialHolder || deployer.address;

    if (!hre.ethers.isAddress(initialHolder)) {
        throw new Error("Endereço inicial inválido.");
    }

    // Verificação adicional do fornecimento antes da implantação.
    const supply = BigInt(cfg.initialSupply);
    const multiplier = 10n ** BigInt(cfg.decimals);
    const maxUint256 = (1n << 256n) - 1n;

    if (supply <= 0n || supply > maxUint256 / multiplier) {
        throw new Error("Fornecimento inicial ultrapassa o limite permitido.");
    }

    console.log("====================================");
    console.log(`IMPLANTANDO TOKEN EM ${selected.name.toUpperCase()}`);
    console.log("====================================");
    console.log("Nome:", cfg.name);
    console.log("Símbolo:", cfg.symbol);
    console.log("Emissão inicial:", cfg.initialSupply);
    console.log("Decimais:", cfg.decimals);
    console.log("Carteira inicial:", initialHolder);
    console.log("Carteira implantadora:", deployer.address);
    console.log("Mint:", cfg.mintEnabled ? "Habilitado" : "Desabilitado");
    console.log("Burn:", cfg.burnEnabled ? "Habilitado" : "Desabilitado");
    console.log(
        `Saldo ${selected.nativeSymbol}:`,
        hre.ethers.formatEther(balance)
    );

    // Identificadores exclusivos desta implantação.
    const uniqueTokenId = hre.ethers.hexlify(
        hre.ethers.randomBytes(32)
    );

    const uniqueFingerprint = hre.ethers.hexlify(
        hre.ethers.randomBytes(32)
    );

    console.log("Token ID:", uniqueTokenId);
    console.log("Fingerprint:", uniqueFingerprint);

   
    // ============================================================
    // IMPLANTAÇÃO UTILIZANDO CREATE2
    // ============================================================
    
    // Carrega o contrato da fábrica.
    const Factory = await hre.ethers.getContractFactory("TokenFactory");
    
    // Implanta uma fábrica para esta operação.
    const factory = await Factory.deploy();
    
    await factory.waitForDeployment();
    
    const factoryAddress = await factory.getAddress();
    
    // ------------------------------------------------------------
    // SALT EXCLUSIVO POR TOKEN E POR REDE
    // ------------------------------------------------------------
    
    // Combina o Chain ID com o identificador aleatório do token.
    // O Chain ID diferencia Polygon, Base, BNB Chain etc.
    const uniqueSalt = hre.ethers.solidityPackedKeccak256(
        ["uint256", "bytes32"],
        [network.chainId, uniqueTokenId]
    );
    
    console.log("Fábrica:", factoryAddress);
    console.log("Chain ID:", network.chainId.toString());
    console.log("Salt CREATE2:", uniqueSalt);
    
    // ------------------------------------------------------------
    // CALCULAR O ENDEREÇO ANTES DA IMPLANTAÇÃO
    // ------------------------------------------------------------
    
    // Simula a chamada para obter o endereço que será criado.
    // Não executa uma transação.
    const address = await factory.deployToken.staticCall(
        cfg.name,
        cfg.symbol,
        cfg.initialSupply,
        cfg.decimals,
        initialHolder,
        uniqueTokenId,
        uniqueFingerprint,
        uniqueSalt
    );
    
    // ------------------------------------------------------------
    // IMPLANTAR O TOKEN
    // ------------------------------------------------------------
    
    const deployTx = await factory.deployToken(
        cfg.name,
        cfg.symbol,
        cfg.initialSupply,
        cfg.decimals,
        initialHolder,
        uniqueTokenId,
        uniqueFingerprint,
        uniqueSalt
    );
    
    const receipt = await deployTx.wait();
    
    if (!receipt || receipt.status !== 1) {
        throw new Error("Falha na implantação do token.");
    }
    
    // Recupera o contrato ERC-20 no endereço criado pela fábrica.
    const token = await hre.ethers.getContractAt(
        "MeuToken",
        address
    );
    
    // Hash da transação que efetivamente criou o token.
    const tx = deployTx;
    
    console.log("Token implantado:", address);
    console.log("Transação:", tx.hash);














    const explorerBase = String(selected.explorer || "")
        .replace(/\/+$/, "");

    const result = {
        network: selected.name,
        networkKey: selected.key,
        chainId: Number(selected.chainId),
        factoryAddress: factoryAddress,
        create2Salt: uniqueSalt,
        nativeCurrency: selected.nativeSymbol,
        name: await token.name(),
        symbol: await token.symbol(),
        totalSupply: (await token.totalSupply()).toString(),
        decimals: Number(await token.decimals()),
        mintEnabled: cfg.mintEnabled,
        burnEnabled: cfg.burnEnabled,
        tokenId: await token.tokenId(),
        uniqueFingerprint: await token.uniqueFingerprint(),
        description: cfg.description,
        initialHolder,
        deployer: deployer.address,
        contractAddress: address,
        transactionHash: tx ? tx.hash : null,
        explorer: explorerBase
            ? `${explorerBase}/address/${address}`
            : null,
        deployedAt: new Date().toISOString()

    };

    const outputDir = path.join(
        __dirname,
        `../deployments/${selected.key}`
    );

    fs.mkdirSync(outputDir, { recursive: true });

    const output = path.join(outputDir, "deployment.json");

    fs.writeFileSync(
        output,
        JSON.stringify(result, null, 2) + "\n",
        { mode: 0o600 }
    );

    console.log("====================================");
    console.log("TOKEN PUBLICADO!");
    console.log(JSON.stringify(result, null, 2));
    console.log("Registro salvo em:", output);
}

main().catch(error => {
    console.error("ERRO:", error);
    process.exitCode = 1;
});
EOF

