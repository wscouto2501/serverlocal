const fs = require("fs");
const c = JSON.parse(fs.readFileSync(".token-config.json", "utf8"));

if (!c.name || typeof c.name !== "string")
    throw Error("Nome ausente ou invalido");

if (!c.symbol || typeof c.symbol !== "string")
    throw Error("Simbolo ausente ou invalido");

if (!/^[0-9]+$/.test(String(c.initialSupply)))
    throw Error("Supply invalido");

if (!Number.isInteger(c.decimals) || c.decimals < 0 || c.decimals > 18)
    throw Error("Decimais invalidos");

if (!c.network || !Number.isInteger(c.network.chainId))
    throw Error("Rede ou Chain ID invalido");

if (typeof c.mintEnabled !== "boolean")
    throw Error("mintEnabled invalido");

if (typeof c.burnEnabled !== "boolean")
    throw Error("burnEnabled invalido");

if (!c.contractName || typeof c.contractName !== "string")
    throw Error("contractName ausente");

const supply = BigInt(c.initialSupply);
const max = (1n << 256n) - 1n;
const multiplier = 10n ** BigInt(c.decimals);

if (supply <= 0n || supply > max / multiplier)
    throw Error("Supply ultrapassa uint256");

if (c.initialHolder &&
    !/^0x[a-fA-F0-9]{40}$/.test(c.initialHolder))
    throw Error("Endereco initialHolder invalido");

if (c.network.family !== "evm" || c.network.module !== "evm")
    throw Error("Rede nao compativel com EVM");

console.log("Nome:", c.name);
console.log("Simbolo:", c.symbol);
console.log("Contrato:", c.contractName);
console.log("Supply:", c.initialSupply);
console.log("Decimais:", c.decimals);
console.log("Mint:", c.mintEnabled);
console.log("Burn:", c.burnEnabled);
console.log("Rede:", c.network.name);
console.log("Chain ID:", c.network.chainId);
NODE
