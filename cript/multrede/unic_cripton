        fi

        if node <<'NODE'
const fs = require("fs");
const path = require("path");

const cfg = JSON.parse(fs.readFileSync(".token-config.json", "utf8"));
const root = "artifacts/contracts";
const files = [];

function walk(dir) {
    if (!fs.existsSync(dir)) return;

    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
        const p = path.join(dir, entry.name);

        if (entry.isDirectory()) walk(p);
        else if (p.endsWith(".json") && !p.endsWith(".dbg.json"))
            files.push(p);
    }
}

walk(root);

const artifacts = [];

for (const file of files) {
    const a = JSON.parse(fs.readFileSync(file, "utf8"));
    if (a.contractName && a.abi) artifacts.push({ file, ...a });
}

function findArtifact(name) {
    return artifacts.find(a => a.contractName === name);
}

const main = findArtifact(cfg.contractName);

if (!main) {
    throw Error("Artefato do contrato principal ausente: " + cfg.contractName);
}

if (!main.bytecode || main.bytecode === "0x")
    throw Error("Bytecode do contrato principal vazio");

const signatures = main.abi
    .filter(x => x.type === "function")
    .map(x => x.name);

for (const fn of ["name", "symbol", "decimals", "totalSupply", "balanceOf", "transfer", "approve", "allowance", "transferFrom"]) {
    if (!signatures.includes(fn))
        throw Error("Funcao ERC20 ausente: " + fn);
}

for (const fn of ["tokenId", "uniqueFingerprint"]) {
    if (!signatures.includes(fn))
        throw Error("Funcao de identificacao ausente: " + fn);
}

const hasMint = signatures.includes("mint");
const hasBurn = signatures.includes("burn");

if (hasMint !== cfg.mintEnabled)
    throw Error("ABI Mint nao corresponde a configuracao.");

if (hasBurn !== cfg.burnEnabled)
    throw Error("ABI Burn nao corresponde a configuracao.");

if (signatures.includes("owner")) {
    console.log("Ownable: funcao owner encontrada.");
} else {
    console.log("AVISO: funcao owner nao encontrada.");
}

console.log("Contrato principal:", cfg.contractName);
console.log("Bytecode:", (main.bytecode.length - 2) / 2, "bytes");
console.log("Funcoes ABI:", signatures.length);
console.log("ERC20: validado");
console.log("Token ID: validado");
console.log("Fingerprint: validado");
console.log("Mint:", hasMint ? "HABILITADO" : "DESABILITADO");
console.log("Burn:", hasBurn ? "HABILITADO" : "DESABILITADO");

const factory = findArtifact("TokenFactory");

if (factory) {
    if (!factory.bytecode || factory.bytecode === "0x")
        throw Error("Bytecode da fabrica vazio");

    console.log("Factory: compilada");
    console.log("Bytecode Factory:", (factory.bytecode.length - 2) / 2, "bytes");
} else {
    console.log("AVISO: artefato TokenFactory nao encontrado.");
}

NODE
        then
            ARTIFACT_OK=1
            ok "ABI e bytecode verificados."
        else
            fail "Falha na validacao da ABI ou bytecode."
        fi
    else
        fail "Diretorio artifacts/contracts ausente."
    fi
else
