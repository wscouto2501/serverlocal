cat > verificar_carteira.sh <<EOF
#!/bin/bash
set -Eeuo pipefail
PROJECT_DIR="${PROJECT_DIR}"
cd "\${PROJECT_DIR}"

node <<'NODE'
require("dotenv").config();
const fs = require("fs");
const { JsonRpcProvider, Wallet, formatEther } = require("ethers");

async function main() {
  if (!process.env.RPC_URL || !process.env.PRIVATE_KEY) {
    throw new Error("Configure RPC_URL e PRIVATE_KEY no .env.");
  }
  const cfg = JSON.parse(fs.readFileSync(".token-config.json", "utf8"));
  const provider = new JsonRpcProvider(process.env.RPC_URL);
  const network = await provider.getNetwork();
  const expected = BigInt(cfg.network.chainId);
  if (network.chainId !== expected) {
    throw new Error(\`Rede incorreta: \${network.chainId}. Esperado \${expected} (\${cfg.network.name}).\`);
  }
  const wallet = new Wallet(process.env.PRIVATE_KEY, provider);
  const balance = await provider.getBalance(wallet.address);
  console.log("Rede:", cfg.network.name);
  console.log("Chain ID:", network.chainId.toString());
  console.log("Carteira:", wallet.address);
  console.log(\`Saldo \${cfg.network.nativeSymbol}:\`, formatEther(balance));
  if (balance === 0n) console.log("ATENÇÃO: carteira sem saldo para gas.");
}
main().catch(error => {
  console.error("ERRO:", error.message);
  process.exitCode = 1;
});
NODE
EOF
