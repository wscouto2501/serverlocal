# ---------------- Implantação ----------------
cat > scripts/deploy.js <<'EOF'
const hre = require("hardhat");
const fs = require("fs");
const path = require("path");

async function main() {
  if (!process.env.PRIVATE_KEY) {
    throw new Error("PRIVATE_KEY nao configurada no arquivo .env");
  }

  const configPath = path.join(__dirname, "../.token-config.json");
  if (!fs.existsSync(configPath)) {
    throw new Error("Configuracao .token-config.json nao encontrada. Execute o instalador.");
  }

  const cfg = JSON.parse(fs.readFileSync(configPath, "utf8"));
  const network = await hre.ethers.provider.getNetwork();

  if (network.chainId !== 137n) {
    throw new Error(`Rede incorreta: ${network.chainId}. Esperado: 137 (Polygon).`);
  }

  const [deployer] = await hre.ethers.getSigners();
  const balance = await hre.ethers.provider.getBalance(deployer.address);

  if (balance === 0n) {
    throw new Error("A carteira nao possui POL para pagar o gas.");
  }

  const initialHolder = cfg.initialHolder || deployer.address;

  if (!hre.ethers.isAddress(initialHolder)) {
    throw new Error("Endereco inicial invalido.");
  }

  console.log("====================================");
  console.log("IMPLANTANDO TOKEN NA POLYGON");
  console.log("====================================");
  console.log("Nome:", cfg.name);
  console.log("Simbolo:", cfg.symbol);
  console.log("Emissao inicial:", cfg.initialSupply);
  console.log("Decimais:", cfg.decimals);
  console.log("Carteira inicial:", initialHolder);
  console.log("Carteira implantadora:", deployer.address);
  console.log("Saldo POL:", hre.ethers.formatEther(balance));

  const Token = await hre.ethers.getContractFactory("MeuToken");
  const token = await Token.deploy(
    cfg.name,
    cfg.symbol,
    cfg.initialSupply,
    cfg.decimals,
    initialHolder,
    cfg.mintEnabled,
    cfg.burnEnabled
  );

  await token.waitForDeployment();

  const address = await token.getAddress();
  const tx = token.deploymentTransaction();

  const result = {
    network: "Polygon Mainnet",
    chainId: 137,
    name: await token.name(),
    symbol: await token.symbol(),
    totalSupply: (await token.totalSupply()).toString(),
    decimals: Number(await token.decimals()),
    mintEnabled: cfg.mintEnabled,
    burnEnabled: cfg.burnEnabled,
    description: cfg.description,
    initialHolder,
    deployer: deployer.address,
    contractAddress: address,
    transactionHash: tx.hash,
    explorer: `https://polygonscan.com/address/${address}`,
    deployedAt: new Date().toISOString()
  };

  const output = path.join(__dirname, "../deployments/polygon.json");
  fs.writeFileSync(output, JSON.stringify(result, null, 2));

  console.log("====================================");
  console.log("TOKEN PUBLICADO!");
  console.log(JSON.stringify(result, null, 2));
}

main().catch(error => {
  console.error("ERRO:", error);
  process.exitCode = 1;
});
EOF

# ---------------- Testes ----------------
cat > test/MeuToken.js <<'EOF'
const { expect } = require("chai");
const { ethers } = require("hardhat");

describe("MeuToken personalizavel", function () {
  async function deployToken(options = {}) {
    const [owner, other] = await ethers.getSigners();
    const Token = await ethers.getContractFactory("MeuToken");

    const token = await Token.deploy(
      options.name || "Minha Moeda",
      options.symbol || "MMC",
      options.supply || "10000000",
      options.decimals ?? 18,
      options.holder || owner.address,
      options.mintEnabled ?? false,
      options.burnEnabled ?? true
    );

    await token.waitForDeployment();
    return { token, owner, other };
  }

  it("usa nome e simbolo informados", async function () {
    const { token } = await deployToken({ name: "RealUnit", symbol: "RUT" });
    expect(await token.name()).to.equal("RealUnit");
    expect(await token.symbol()).to.equal("RUT");
  });

  it("emite a quantidade inicial para a carteira escolhida", async function () {
    const { token, other } = await deployToken({
      supply: "2500",
      holder: undefined
    });
    expect(await token.balanceOf(other.address)).to.equal(0n);
    expect(await token.totalSupply()).to.equal(ethers.parseUnits("2500", 18));
  });

  it("usa as casas decimais configuradas", async function () {
    const { token } = await deployToken({ decimals: 6 });
    expect(await token.decimals()).to.equal(6);
    expect(await token.totalSupply()).to.equal(10_000_000n * 10n ** 6n);
  });

  it("permite mint apenas quando habilitado e pelo proprietario", async function () {
    const { token, other } = await deployToken({ mintEnabled: true });
    await token.mint(other.address, 100n);
    expect(await token.balanceOf(other.address)).to.equal(100n);
  });

  it("bloqueia mint quando desabilitado", async function () {
    const { token, other } = await deployToken({ mintEnabled: false });
    await expect(token.mint(other.address, 100n)).to.be.revertedWith("Mint disabled");
  });

  it("permite queima quando habilitada", async function () {
    const { token, owner } = await deployToken({ burnEnabled: true });
    await token.burn(ethers.parseUnits("100", 18));
    expect(await token.balanceOf(owner.address)).to.equal(ethers.parseUnits("9999900", 18));
  });
});
EOF

