require("dotenv").config();
const { ethers } = require("ethers");

async function main() {
  const rpcUrl        = process.env.RPC_URL;
  const privateKey    = process.env.PRIVATE_KEY;
  const tokenAddress  = process.env.TOKEN_ADDRESS;

  if (!rpcUrl || !privateKey || !tokenAddress) {
    throw new Error("RPC_URL, PRIVATE_KEY e TOKEN_ADDRESS são obrigatórios.");
  }

  console.log("Conectando à rede...");
  const provider = new ethers.JsonRpcProvider(rpcUrl);

  const network = await provider.getNetwork();
  console.log(`Rede detectada: ${network.name} (chainId ${network.chainId})`);

  const wallet = new ethers.Wallet(privateKey, provider);
  console.log(`Carteira publicadora: ${wallet.address}`);

  const balance = await provider.getBalance(wallet.address);
  console.log(`Saldo (MATIC): ${ethers.formatEther(balance)}`);

  if (balance === 0n) {
    throw new Error("Saldo insuficiente para pagar o gas.");
  }

  // Verifica se o contrato existe na rede
  const code = await provider.getCode(tokenAddress);
  if (code === "0x") {
    throw new Error(`Nenhum contrato encontrado em ${tokenAddress}`);
  }
  console.log("Contrato encontrado. Lendo metadados...");

  // ABI mínima ERC-20
  const abi = [
    "function name() view returns (string)",
    "function symbol() view returns (string)",
    "function decimals() view returns (uint8)",
    "function totalSupply() view returns (uint256)",
    "function balanceOf(address) view returns (uint256)",
    "function transfer(address,uint256) returns (bool)"
  ];

  const token = new ethers.Contract(tokenAddress, abi, wallet);

  try {
    const [name, symbol, decimals, totalSupply] = await Promise.all([
      token.name(), token.symbol(), token.decimals(), token.totalSupply()
    ]);
    console.log("--------------------------------------------");
    console.log(`Nome:           ${name}`);
    console.log(`Símbolo:        ${symbol}`);
    console.log(`Decimais:       ${decimals}`);
    console.log(`Supply total:   ${ethers.formatUnits(totalSupply, decimals)} ${symbol}`);
    console.log("--------------------------------------------");
  } catch (e) {
    console.warn("Não foi possível ler todos os metadados ERC-20:", e.message);
  }

  console.log("✅ Publicação da carteira/token validada com sucesso.");
}

main().catch((err) => {
  console.error("❌ Falha na publicação:", err.message);
  process.exit(1);
});
