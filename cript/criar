# ---------------- Contrato ERC20 personalizável ----------------
cat > contracts/MeuToken.sol <<'EOF'
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract MeuToken is ERC20, Ownable {
    uint8 private immutable _customDecimals;
    bool public immutable mintEnabled;
    bool public immutable burnEnabled;

    constructor(
        string memory tokenName,
        string memory tokenSymbol,
        uint256 initialSupply,
        uint8 tokenDecimals,
        address initialHolder,
        bool enableMint,
        bool enableBurn
    ) ERC20(tokenName, tokenSymbol) Ownable(msg.sender) {
        require(initialHolder != address(0), "Invalid initial holder");
        require(tokenDecimals <= 18, "Decimals above 18");

        _customDecimals = tokenDecimals;
        mintEnabled = enableMint;
        burnEnabled = enableBurn;

        uint256 multiplier = 10 ** uint256(tokenDecimals);
        _mint(initialHolder, initialSupply * multiplier);
    }

    function decimals() public view override returns (uint8) {
        return _customDecimals;
    }

    // Somente o proprietario pode emitir novos tokens, se a opcao foi ativada.
    function mint(address to, uint256 amount) external onlyOwner {
        require(mintEnabled, "Mint disabled");
        require(to != address(0), "Invalid recipient");
        _mint(to, amount);
    }

    // Queima tokens da propria carteira do titular, se ativada.
    function burn(uint256 amount) external {
        require(burnEnabled, "Burn disabled");
        _burn(msg.sender, amount);
    }
}
EOF

