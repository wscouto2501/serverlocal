  echo "Execute como root: sudo bash instalar_moeda.sh"
  exit 1
fi

# ---------------- Node.js 20+ ----------------
if ! command -v node >/dev/null 2>&1 || \
   ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)' 2>/dev/null; then
  echo "Instalando Node.js 20..."
  apt-get update
  apt-get install -y ca-certificates curl
  curl -fsSL https://deb.nodesource.com/setup_20.x -o /tmp/nodesource_setup.sh
  bash /tmp/nodesource_setup.sh
  apt-get install -y nodejs
  rm -f /tmp/nodesource_setup.sh
fi

echo "Node.js: $(node -v)"
echo "NPM: $(npm -v)"

echo
echo "=================================================="
echo "       CONFIGURAÇÃO DA SUA CRIPTOMOEDA"
echo "=================================================="
echo "Preencha os dados. A implantação só ocorrerá"
echo "posteriormente, quando você executar o comando."
echo


read -r -p "Nome da moeda [RealUnit]: " TOKEN_NAME
TOKEN_NAME="${TOKEN_NAME:-RealUnit}"

read -r -p "Símbolo/ticker [RUT]: " TOKEN_SYMBOL
TOKEN_SYMBOL="${TOKEN_SYMBOL:-RUT}"

read -r -p "Quantidade inicial de tokens [10000000]: " INITIAL_SUPPLY
INITIAL_SUPPLY="${INITIAL_SUPPLY:-10000000}"

read -r -p "Casas decimais (0 a 18) [18]: " TOKEN_DECIMALS
TOKEN_DECIMALS="${TOKEN_DECIMALS:-18}"

read -r -p "Carteira que receberá a emissão inicial (vazio = carteira implantadora): " INITIAL_HOLDER

read -r -p "Permitir novas emissões pelo administrador? (s/N): " MINT_ANSWER
MINT_ANSWER="${MINT_ANSWER:-N}"

read -r -p "Permitir que qualquer titular queime seus próprios tokens? (S/n): " BURN_ANSWER
BURN_ANSWER="${BURN_ANSWER:-S}"

read -r -p "Descrição do projeto (opcional): " TOKEN_DESCRIPTION

# ==================================================
# CRIAR DIRETÓRIO COM O NOME DA CRIPTOMOEDA
# ==================================================

# Converter nome para minúsculas e remover caracteres especiais
TOKEN_DIR=$(echo "$TOKEN_NAME" \
    | iconv -f UTF-8 -t ASCII//TRANSLIT \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9]/-/g; s/-\+/-/g; s/^-//; s/-$//')

if [[ -z "$TOKEN_DIR" ]]; then
    echo "ERRO: nome inválido para criar o diretório."
    exit 1
fi

PROJECT_DIR="/root/$TOKEN_DIR"

if [[ -d "$PROJECT_DIR" ]]; then
    echo "ERRO: o diretório $PROJECT_DIR já existe."
    exit 1
fi

mkdir -p "$PROJECT_DIR"
cd "$PROJECT_DIR"

mkdir -p contracts scripts test deployments

echo
echo "=========================================="
echo "PROJETO CRIADO"
echo "=========================================="
echo "Nome da moeda: $TOKEN_NAME"
echo "Símbolo: $TOKEN_SYMBOL"
echo "Diretório: $PROJECT_DIR"
echo "=========================================="



# Validações básicas
if [[ ! "$TOKEN_NAME" =~ ^[[:print:]]{1,64}$ ]]; then
  echo "ERRO: nome inválido ou maior que 64 caracteres."
  exit 1
fi

if [[ ! "$TOKEN_SYMBOL" =~ ^[A-Za-z0-9]{1,12}$ ]]; then
  echo "ERRO: símbolo deve conter de 1 a 12 letras/números."
  exit 1
fi

if [[ ! "$INITIAL_SUPPLY" =~ ^[0-9]+([.][0-9]+)?$ ]] || [[ "$INITIAL_SUPPLY" == "0" ]]; then
  echo "ERRO: quantidade inicial inválida."
  exit 1
fi

if [[ ! "$TOKEN_DECIMALS" =~ ^([0-9]|1[0-8])$ ]]; then
  echo "ERRO: casas decimais deve ser um número entre 0 e 18."
  exit 1
fi

if [[ -n "$INITIAL_HOLDER" ]] && \
   [[ ! "$INITIAL_HOLDER" =~ ^0x[a-fA-F0-9]{40}$ ]]; then
  echo "ERRO: endereço da carteira inválido."
  exit 1
fi

MINT_ENABLED=false
[[ "$MINT_ANSWER" =~ ^[Ss]$ ]] && MINT_ENABLED=true

BURN_ENABLED=false
[[ ! "$BURN_ANSWER" =~ ^[Nn]$ ]] && BURN_ENABLED=true

# Grava configuração JSON com escape seguro feito pelo Node.
TOKEN_NAME="$TOKEN_NAME" \
TOKEN_SYMBOL="$TOKEN_SYMBOL" \
INITIAL_SUPPLY="$INITIAL_SUPPLY" \
TOKEN_DECIMALS="$TOKEN_DECIMALS" \
INITIAL_HOLDER="$INITIAL_HOLDER" \
MINT_ENABLED="$MINT_ENABLED" \
BURN_ENABLED="$BURN_ENABLED" \
TOKEN_DESCRIPTION="$TOKEN_DESCRIPTION" \
node <<'NODE'
const fs = require("fs");
const config = {
  name: process.env.TOKEN_NAME,
  symbol: process.env.TOKEN_SYMBOL,
  initialSupply: process.env.INITIAL_SUPPLY,
  decimals: Number(process.env.TOKEN_DECIMALS),
  initialHolder: process.env.INITIAL_HOLDER || "",
  mintEnabled: process.env.MINT_ENABLED === "true",
  burnEnabled: process.env.BURN_ENABLED === "true",
  description: process.env.TOKEN_DESCRIPTION || ""
};
fs.writeFileSync(".token-config.json", JSON.stringify(config, null, 2) + "\n", { mode: 0o600 });
NODE

echo
echo "---------------- RESUMO ----------------"
node -e '
const c=require("./.token-config.json");
console.log("Nome:",c.name);
console.log("Símbolo:",c.symbol);
console.log("Emissão inicial:",c.initialSupply);
console.log("Casas decimais:",c.decimals);
console.log("Carteira inicial:",c.initialHolder || "Carteira que implantar");
console.log("Novas emissões:",c.mintEnabled ? "Permitidas ao administrador" : "Desativadas");
console.log("Queima:",c.burnEnabled ? "Ativada" : "Desativada");
console.log("Descrição:",c.description || "(não informada)");
'
echo "----------------------------------------"
read -r -p "Confirma essa configuração? (s/N): " CONFIRM
if [[ ! "$CONFIRM" =~ ^[Ss]$ ]]; then
