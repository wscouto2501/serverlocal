#!/bin/bash

while true; do
    clear
    [ -f /etc/issue ] && cat /etc/issue && echo
    echo "======================================"
    echo "         MENU DE INSTALAÇÃO"
    echo "======================================"
    echo ""
    echo " 1) Instalar Tailscale"
    echo " 2) Install Tunnel Server"
    echo " 3) Instalador Setup"
    echo " 4) Configurar Firewall"
    echo "======================================"
    echo " 5) Status do Servidor"
    echo " 6) Reiniciar"
    echo " 7) Desligar"
    echo " 8) Atualizar o Servidor"
    echo "======================================"
    echo " 9) Configurar DHCP"
    echo "======================================"
    echo "10) Instalar Php + Mysql (Instalar o Traefik + Portainer com Setup menu(3))"
    echo "11) Configurar Lavarel"
    echo "12) Liberar acesso diretorio www"
    echo "======================================"
    echo "13) Limpar Cache (Preparar Template/Clonar máquina)"
    echo "14) Restore Cache (Prepara Máquina para uso)"
    echo "======================================"
    echo "15) configurar SSH + root"
    echo "16) Gerar chave publica para conectar sem senha."
    echo "17) Adicionar chave publica para conectar sem senha."
    echo "======================================"
    echo "18) Instalar o LogPose (Gerenciador de Utms)"
    echo "19) Instalar Coolfy(plataforma de gerenciamento de aplicações)."
    echo "20) Instalar CRM Vocero(plataforma de gerenciamento de cliente pelo Whatsapp)."
    echo "21) Instalar Instalar o Codex para editar codigo com OpenAI."

    echo " 0) Sair"
    echo ""

    read -p "Escolha uma opção: " OPCAO

    case $OPCAO in
        1)
            echo "Executando Tailscale..."
            bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/tailscale)
            ;;
        2)
            echo "Executando Install Server..."
            bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/installserver)
            ;;
        3)
            echo "Executando Setup..."
            bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/SetupOrion/main/Setup)
            ;;

        4)
            echo "Executando Firewall..."
            bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/firewall)
            ;;


        5)
           while true; do
             clear
             uptime
             echo
             free -h
             echo
             df -h -x overlay -x tmpfs
             echo
             echo "Enter para voltar"
             read -t 1 key && break
           done
           ;;
        6)
          echo "Reiniciando, aguarde..."
          systemctl reboot
          exit 0
          ;;
        7)
          echo "Desligando, aguarde..."
          systemctl poweroff
          exit 0
          ;;
        8)
          apt update && apt upgrade -y
          read -p "Sistema atualizado, precione ENTER para voltar..."
          ;;
        9)
           echo "Executando Install DHCP..."
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/dhcp)
           ;;
        10)
            if command -v docker &> /dev/null
            then
                echo "Docker encontrado. Executando Install PHP + MySQL..."
                bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/php_mysql)
            else
                echo "Docker não instalado. Instale o Docker antes de continuar. utilizando a opção 3) Instalador Setup"
                exit 1
            fi
            ;;
        11)
           echo "Executando configuração Lavarel."
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/laravel)
           ;;
        12)
           echo "Executando configuração de acesso www."
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/access_www)
           ;;
        13)
           echo "Executando limpaza"
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/proxmox)
           ;;
        14)
           echo "Executando restaure"
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/proxmox_recure)
           ;;
        15)
           echo "Executando configuração SSH"
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/sshroot)
           ;;
        16)
           echo "Criando chave SSH para acesso sem senha"
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/keyssh)
           ;;
        17)
           echo "Adicionando chave SSH para acesso sem senha"
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/sshpublic)
           ;;
        18)
           echo "Executando configuração SSH"
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/logpose)
           ;;
        19)
           echo "Executando Instalação do Coolify."
           bash <(curl -fsSL https://cdn.coollabs.io/coolify/install.sh)
           ;;
        20)
           echo "Executando Instalação do CRM Vocero"
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/crmvocero)
           ;;
        21)
           echo "Executando Instalação do Codex da OpenAI"
           bash <(curl -fsSL https://raw.githubusercontent.com/wscouto2501/serverlocal/main/codex)
           ;;

        0)
            clear
            echo "Saindo..."
            exit 0
            ;;
        *)
            echo ""
            echo "Opção inválida."
            ;;
    esac
    echo ""
    read -p "Pressione ENTER para voltar ao menu..."
done
